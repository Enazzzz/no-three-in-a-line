{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NTILClaim",
  "type": "object",
  "required": ["n", "points", "worker_id"],
  "properties": {
    "job_id": { "type": ["string", "null"] },
    "n": { "type": "integer", "minimum": 1 },
    "points": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "size": { "type": "integer" },
    "ratio": { "type": "number" },
    "family": { "type": "string" },
    "params": { "type": "object" },
    "stats": { "type": "object" },
    "worker_id": { "type": "string" },
    "claimed_at": { "type": "string" }
  }
}
